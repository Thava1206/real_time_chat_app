rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Any signed-in user can read profiles (needed to find contacts), but
    // only the owner can create or edit their own, and never delete it.
    match /users/{uid} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 50
        && request.resource.data.get('bio', '').size() <= 140;
      allow delete: if false;

      match /contacts/{contactUid} {
        allow read, delete: if request.auth != null
          && request.auth.uid == uid;
        allow create, update: if request.auth != null
          && request.auth.uid == uid
          && contactUid != uid
          && request.resource.data.keys().hasOnly(['createdAt'])
          && request.resource.data.createdAt == request.time;
      }
    }

    // Only the two participants can read a conversation or its messages.
    match /conversations/{conversationId} {
      allow read: if request.auth != null
        && request.auth.uid in resource.data.participants;
      allow create, update: if request.auth != null
        && request.resource.data.participants.size() == 2
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.lastMessage is string
        && request.resource.data.lastMessage.size() <= 2000
        && request.resource.data.lastSenderId == request.auth.uid;
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if request.auth != null
          && request.auth.uid in conversationId.split('_');
        allow create: if request.auth != null
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 2000
          && request.auth.uid in getAfter(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
        allow update, delete: if false;
      }
    }
  }
}
