rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Any signed-in user can read profiles (needed to find contacts), but
    // only the owner can create or edit their own, and never delete it.
    match /users/{uid} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 50
        && request.resource.data.get('bio', '').size() <= 140
        // Base64 profile photo, kept small since every chat list reads it.
        && request.resource.data.get('photo', '') is string
        && request.resource.data.get('photo', '').size() <= 100000;
      allow delete: if false;

      match /contacts/{contactUid} {
        allow read, delete: if request.auth != null
          && request.auth.uid == uid;
        allow create: if request.auth != null
          && request.auth.uid == uid
          && contactUid != uid
          && request.resource.data.keys().hasOnly(['createdAt'])
          && request.resource.data.createdAt == request.time;
        allow update: if request.auth != null
          && request.auth.uid == uid
          && contactUid != uid
          && request.resource.data.keys().hasOnly(
            ['createdAt', 'displayName', 'note'])
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.displayName is string
          && request.resource.data.displayName.size() > 0
          && request.resource.data.displayName.size() <= 50
          && request.resource.data.note is string
          && request.resource.data.note.size() <= 140;
      }
    }

    // A chat's id is its two participants' uids, sorted and joined with "_",
    // so membership can be checked from the path even before the chat exists.
    function isChatMember(chatId) {
      return request.auth != null
        && chatId.split('_').size() == 2
        && request.auth.uid in chatId.split('_');
    }

    function isValidText(text) {
      return text is string && text.size() > 0 && text.size() <= 1000;
    }

    // Base64 image, capped to stay under Firestore's 1 MiB document limit.
    function isValidImage(image) {
      return image is string && image.size() > 0 && image.size() <= 900000;
    }

    match /chats/{chatId} {
      // Checked against the stored participants so the Messages tab can list
      // chats with an array-contains query.
      allow read: if request.auth != null
        && request.auth.uid in resource.data.participants;
      allow create, update: if isChatMember(chatId)
        && request.resource.data.keys().hasOnly(
          ['participants', 'lastMessage', 'lastSenderId', 'updatedAt'])
        && request.resource.data.participants == chatId.split('_')
        && request.resource.data.lastSenderId == request.auth.uid
        && isValidText(request.resource.data.lastMessage)
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;

      // Messages can be sent and read by the two members, but never edited.
      // A message is either text, or an image with empty text.
      match /messages/{messageId} {
        allow read: if isChatMember(chatId);
        allow create: if isChatMember(chatId)
          && request.resource.data.keys().hasOnly(
            ['senderId', 'text', 'image', 'createdAt'])
          && request.resource.data.senderId == request.auth.uid
          && (('image' in request.resource.data
                && isValidImage(request.resource.data.image)
                && request.resource.data.text == '')
            || (!('image' in request.resource.data)
                && isValidText(request.resource.data.text)))
          && request.resource.data.createdAt == request.time;
        allow update, delete: if false;
      }
    }
  }
}
