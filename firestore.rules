rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Any signed-in user can read profiles (needed to find contacts), but
    // only the owner can create or edit their own, and never delete it.
    match /users/{uid} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 50
        && request.resource.data.get('bio', '').size() <= 140
        // Base64 profile photo, kept small since every chat list reads it.
        && request.resource.data.get('photo', '') is string
        && request.resource.data.get('photo', '').size() <= 100000;
      allow delete: if false;

      match /contacts/{contactUid} {
        allow read, delete: if request.auth != null
          && request.auth.uid == uid;
        allow create: if request.auth != null
          && request.auth.uid == uid
          && contactUid != uid
          && request.resource.data.keys().hasOnly(['createdAt'])
          && request.resource.data.createdAt == request.time;
        allow update: if request.auth != null
          && request.auth.uid == uid
          && contactUid != uid
          && request.resource.data.keys().hasOnly(
            ['createdAt', 'displayName', 'note'])
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.displayName is string
          && request.resource.data.displayName.size() > 0
          && request.resource.data.displayName.size() <= 50
          && request.resource.data.note is string
          && request.resource.data.note.size() <= 140;
      }
    }

    // Membership is stored on each conversation so group ids can be generated
    // independently of the participant list.
    function isChatMember(chatId) {
      return request.auth != null
        && exists(/databases/$(database)/documents/chats/$(chatId))
        && request.auth.uid in get(
          /databases/$(database)/documents/chats/$(chatId)
        ).data.participants;
    }

    // Includes a conversation created in the same atomic batch as its first
    // message, while still checking the members in the committed chat data.
    function isChatMemberAfter(chatId) {
      return request.auth != null
        && existsAfter(/databases/$(database)/documents/chats/$(chatId))
        && request.auth.uid in getAfter(
          /databases/$(database)/documents/chats/$(chatId)
        ).data.participants;
    }

    function isValidText(text) {
      return text is string && text.size() > 0 && text.size() <= 1000;
    }

    // Base64 image, capped to stay under Firestore's 1 MiB document limit.
    function isValidImage(image) {
      return image is string && image.size() > 0 && image.size() <= 900000;
    }

    function isValidChatWrite(data) {
      return data.keys().hasOnly([
          'participants', 'type', 'name', 'createdBy',
          'lastMessage', 'lastSenderId', 'updatedAt'
        ])
        && data.participants is list
        && data.participants.size() >= 2
        && request.auth.uid in data.participants
        && data.lastSenderId == request.auth.uid
        && isValidText(data.lastMessage)
        && data.updatedAt == request.time;
    }

    match /chats/{chatId} {
      // Checked against the stored participants so the Messages tab can list
      // chats with an array-contains query.
      allow read: if request.auth != null
        && request.auth.uid in resource.data.participants;
      allow create: if request.auth != null
        && isValidChatWrite(request.resource.data)
        && (
          (request.resource.data.get('type', 'direct') == 'direct'
            && request.resource.data.participants.size() == 2)
          ||
          (request.resource.data.type == 'group'
            && request.resource.data.participants.size() >= 3
            && request.resource.data.name is string
            && request.resource.data.name.size() > 0
            && request.resource.data.name.size() <= 50
            && request.resource.data.createdBy == request.auth.uid)
        );
      allow update: if isChatMember(chatId)
        && isValidChatWrite(request.resource.data)
        && request.resource.data.participants == resource.data.participants
        && request.resource.data.get('type', 'direct')
          == resource.data.get('type', 'direct')
        && request.resource.data.get('name', '') == resource.data.get('name', '')
        && request.resource.data.get('createdBy', '')
          == resource.data.get('createdBy', '');
      allow delete: if false;

      // Messages can be sent and read by the two members, but never edited.
      // A message is either text, or an image with empty text.
      match /messages/{messageId} {
        allow read: if isChatMember(chatId);
        allow create: if isChatMemberAfter(chatId)
          && request.resource.data.keys().hasOnly(
            ['senderId', 'text', 'image', 'createdAt'])
          && request.resource.data.senderId == request.auth.uid
          && (('image' in request.resource.data
                && isValidImage(request.resource.data.image)
                && request.resource.data.text == '')
            || (!('image' in request.resource.data)
                && isValidText(request.resource.data.text)))
          && request.resource.data.createdAt == request.time;
        allow update, delete: if false;
      }
    }
  }
}
